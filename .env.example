# Use the delayed key for liquidity diagnostics until live API access is activated.
BETFAIR_APP_KEY_DELAYED=
BETFAIR_APP_KEY=
# Certificate login uses these to create a fresh session token.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_FILE=certs/client-2048.crt
BETFAIR_KEY_FILE=certs/client-2048.key
# Temporary fallback SSO/session token from Betfair demo tools or login flow.
BETFAIR_SESSION_TOKEN=
SMARKETS_USERNAME=
SMARKETS_PASSWORD=
THE_ODDS_API_KEY=

# Optional defaults
BETFAIR_COMMISSION=0.05
SMARKETS_COMMISSION=0.02
MIN_EDGE=0.02
MIN_LIQUIDITY=10

# Live execution defaults are intentionally off and dry-run.
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_DRY_RUN=true
LIVE_ORDER_TABLE=sports-stat-arb-live-orders
LIVE_ALLOWED_SPORT_PREFIXES=soccer_
LIVE_ALLOWED_BOOKMAKERS=matchbook,betfair,smarkets
LIVE_ALLOWED_BET_SIDES=back,lay
LIVE_MAX_REFERENCE_DISAGREEMENT_PCT=0.03
LIVE_REQUIRE_CONFIRMED_LIQUIDITY=true
LIVE_PREVENT_STACKED_EVENT_EXPOSURE=true
LIVE_BANKROLL=1000
LIVE_KELLY_FRACTION=0.10
LIVE_MAX_ORDER_RISK_PCT=0.005
LIVE_MAX_DAILY_RISK_PCT=0.02
LIVE_MIN_ORDER_RISK=1
LIVE_MAX_ORDER_RISK=10
