# Use the delayed key for liquidity diagnostics until live API access is activated.
BETFAIR_APP_KEY_DELAYED=
BETFAIR_APP_KEY=
# Certificate login uses these to create a fresh session token.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_FILE=certs/client-2048.crt
BETFAIR_KEY_FILE=certs/client-2048.key
# Temporary fallback SSO/session token from Betfair demo tools or login flow.
BETFAIR_SESSION_TOKEN=
SMARKETS_USERNAME=
SMARKETS_PASSWORD=
THE_ODDS_API_KEY=

# Optional defaults
BETFAIR_COMMISSION=0.05
SMARKETS_COMMISSION=0.02
MIN_EDGE=0.02
MIN_LIQUIDITY=10
